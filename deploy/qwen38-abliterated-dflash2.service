[Unit]
Description=Qwen3.8-27B ARA abliterated NVFP4 with DFlash2 on DGX Spark
After=network-online.target
Wants=network-online.target qwen38-abliterated-dflash2-proxy.service
Before=qwen38-abliterated-dflash2-proxy.service
Conflicts=qwen38-dflash2.service qwen38-flash-next-q3.service qwen38-aday-vllm.service

[Service]
Type=simple
ExecStart=%h/.local/bin/qwen38-abliterated-dflash2-service.sh
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=90
KillMode=control-group

[Install]
WantedBy=default.target
